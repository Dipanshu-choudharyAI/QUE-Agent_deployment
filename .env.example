# QUE Agent — local / deploy configuration
# Copy to `.env` and fill in real values. Never commit `.env`.

# --- App ---
APP_ENV=local
APP_NAME=QUE-Agent
APP_VERSION=0.1.0
# Browser calls QUE directly — list Quizzer frontend origin(s).
# Example: http://localhost:3000,https://app.quizzer.example
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Service auth (server → QUE only; never ship to the browser) ---
# Future QUE→Quizzer tool calls / ops. Optional for browser chat.
QUE_SERVICE_KEY=change-me-to-a-long-random-secret

# When true (local only), skip auth checks so you can hit /docs.
# Production startup refuses to start if this is true.
ALLOW_INSECURE_LOCAL_NO_AUTH=false

# --- Que access JWT (browser → QUE) ---
# MUST match Quizzer Backend QUE_JWT_SECRET. Quizzer mints; QUE verifies.
QUE_JWT_SECRET=change-me-to-a-long-shared-que-jwt-secret-32chars
QUE_JWT_ALGORITHM=HS256
QUE_JWT_AUDIENCE=que-agent
QUE_JWT_ISSUER=quizzer

# --- LLM (OpenAI-compatible) ---
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openai/gpt-4o-mini
LLM_TIMEOUT_SECONDS=45
LLM_MAX_TOKENS=700
LLM_TEMPERATURE=0.35

# --- QUE-local cache (in-process; NOT Quizzer Redis) ---
QUE_CACHE_ENABLED=true
QUE_CACHE_MAX_ENTRIES=512
# FAQ intent resolution
QUE_CACHE_INTENT_TTL_SECONDS=3600
# Repeated LLM answers for the same conversation turn fingerprint
QUE_CACHE_LLM_TTL_SECONDS=900
# Avoid repeating the same canned variant back-to-back in a conversation
QUE_CACHE_VARIANT_TTL_SECONDS=1800

# Short-term conversation memory (LangGraph MemorySaver — per worker process)
QUE_MEMORY_ENABLED=true
QUE_MEMORY_MAX_TURNS=20

# --- Server ---
HOST=0.0.0.0
PORT=8100
LOG_LEVEL=INFO
